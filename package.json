{
  "name": "skycommand-automation",
  "version": "1.0.0",
  "description": "AI-powered Playwright automation framework for SkyCommand",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:qa": "dotenv -e .env.qa -- playwright test",
    "test:prod": "dotenv -e .env.prod -- playwright test",
    "test:qa:headed": "dotenv -e .env.qa -- playwright test --headed",
    "test:prod:headed": "dotenv -e .env.prod -- playwright test --headed",
    "test:chrome": "playwright test --project=chromium",
    "test:sanity": "playwright test --grep @sanity",
    "test:sanity:headed": "playwright test --grep @sanity --headed",
    "test:qa:sanity": "dotenv -e .env.qa -- playwright test --grep @sanity",
    "test:prod:sanity": "dotenv -e .env.prod -- playwright test --grep @sanity",
    "test:auth": "playwright test tests/authentication.spec.ts",
    "test:insights": "playwright test tests/portfolio-insights.spec.ts",
    "test:navigation": "playwright test tests/navigation.spec.ts",
    "generate:tests": "node agents/orchestrator.js",
    "plan:tests": "node agents/planner.js",
    "generate:only": "node agents/generator.js",
    "heal:tests": "node agents/healer.js",
    "parse:testcases": "node agents/testcase-parser.js",
    "status:testcases": "node agents/testcase-parser.js --status",
    "generate:from-markdown": "node agents/orchestrator.js --from-markdown",
    "generate:only-new": "node agents/orchestrator.js --from-markdown --only-new",
    "report": "playwright show-report reports/html",
    "report:open": "playwright show-report reports/html",
    "codegen": "playwright codegen https://qa-skycommand.skypoint.ai",
    "install:browsers": "playwright install chromium",
    "clean": "rimraf reports/* && rimraf test-results/*"
  },
  "dependencies": {
    "@playwright/test": "^1.49.0",
    "@sendgrid/mail": "^8.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv-cli": "^7.4.2",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "marked": "^15.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=18.0.0" },
  "keywords": ["playwright", "automation", "testing", "ai-powered", "self-healing"],
  "license": "MIT"
}
