# !!! WARNING: THIS TARGETS PRODUCTION - use read-only test accounts !!!
# ============================================
# SkyCommand Automation - Environment Config
# ============================================

# --- Application URLs ---
BASE_URL=https://skycommand.skypoint.ai
API_URL=https://skycommand.skypoint.ai/api

# --- Tenant / Instance ---
INSTANCE_ID=f507ae68-5a2b-447e-a78c-5098e889e16d

# Tenant to test. The suite selects this in the user-menu tenant dropdown.
TENANT=Westmont

# --- Test Configuration ---
HEADLESS=true
SLOWMO=0
CI=false
SKIP_AUTH=false

# --- Self-Healing ---
AUTO_HEAL=true
HEALING_CONFIDENCE_THRESHOLD=0.8

# --- Authentication Credentials ---
# local = B2C email+password form;  microsoft = Microsoft SSO (@skypoint.ai accounts)
AUTH_METHOD=microsoft
# FILL THESE IN - never commit the real values
TEST_USER_EMAIL=your-qa-user@skypoint.ai
TEST_USER_PASSWORD=

# --- Timeouts (ms) ---
DEFAULT_TIMEOUT=45000
NAVIGATION_TIMEOUT=90000
ACTION_TIMEOUT=20000

# --- Reporting ---
REPORT_DIR=./reports
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# --- Browser ---
DEFAULT_BROWSER=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# --- Retry ---
MAX_RETRIES=3
RETRY_DELAY=2000

# --- Logging ---
LOG_LEVEL=info
VERBOSE=false

# --- Notifications ---
NOTIFICATIONS_ENABLED=false
# --- Results email (sent via the Outlook desktop app) ---
NOTIFY_EMAIL=true
NOTIFY_EMAIL_TO=umeshgouda.hiregoudra@skypoint.ai
